{
  "name": "kccf-ministry",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "BUN_ENV=development bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun --external @orisun/eventstore-client",
    "start": "bun run dist/index.js",
    "type-check": "bunx tsc --watch --noEmit",
    "setup": "bun run db:migrate && bun run db:seed && bun run css:build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "css:build": "bunx @tailwindcss/cli -i src/input.css -o static/style.css",
    "css:watch": "bunx @tailwindcss/cli -i src/input.css -o static/style.css --watch"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.2.0",
    "@nats-io/kv": "^3.2.0",
    "@nats-io/transport-node": "^3.2.0",
    "@orisun/eventstore-client": "https://codeload.github.com/oexza/orisun-node-client/tar.gz/5eadf7e79bccc73a4607c7d327373ef825819c5d",
    "@types/pg": "^8.16.0",
    "charts.css": "^1.2.0",
    "drizzle-orm": "^0.45.1",
    "flat": "^6.0.1",
    "hono": "^4.11.1",
    "hono-sessions": "^0.8.0",
    "kanban-hono-datastar": ".",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "valibot": "1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@types/pino": "^7.0.5",
    "autoprefixer": "^10.4.23",
    "bun-types": "latest",
    "daisyui": "^5.5.14",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}